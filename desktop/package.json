{
  "name": "aa-live",
  "productName": "AA Live",
  "version": "1.1.13",
  "description": "A live splitter for Minecraft AA No Reset runs",
  "author": "Zesskyo",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.zesskyo.aalive",
    "productName": "AA Live",
    "files": [
      "main.cjs",
      "preload.cjs",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../app/aa-live.mjs",
        "to": "aa-live.mjs"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AA Live"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Game"
    },
    "artifactName": "AA-Live-${version}-${os}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "zesskyo",
        "repo": "aa-no-reset-timer"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
